# Copy this file to application.properties and fill in your MySQL password.

churn.api.base-url=http://localhost:8000

spring.datasource.url=jdbc:mysql://localhost:3306/churnpredictor
spring.datasource.username=churnpredictor
spring.datasource.password=CHANGE_ME

# schema is owned by churnpredictor-setup.sql, Hibernate must not touch it
spring.jpa.hibernate.ddl-auto=none

# batch inserts so large uploads/scores are one round-trip per 1000 rows, not per row
spring.jpa.properties.hibernate.jdbc.batch_size=1000
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true

# large CSV uploads (millions of rows); stream to a temp file above 2MB instead of buffering
spring.servlet.multipart.max-file-size=600MB
spring.servlet.multipart.max-request-size=600MB
spring.servlet.multipart.file-size-threshold=2MB
